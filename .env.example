# Server Configuration
NODE_ENV=development
PORT=5000

# Google Gemini Generation API
# Obtain from Google AI Studio (https://aistudio.google.com/)
# If absent: Gracefully falls back to direct verified knowledge excerpts
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_TIMEOUT_MS=15000

# Embedding Provider (Optional)
# If absent: Defaults to deterministic local-hash-v1 (384-dim) vectorizer
QWEN_HF_TOKEN=
EMBEDDING_MODEL_NAME=Qwen/Qwen3-Embedding-0.6B
EMBEDDING_API_URL=
EMBEDDING_API_KEY=
EMBEDDING_TIMEOUT_MS=12000

# RAG Pipeline Parameters
RAG_TOP_K=5
RAG_MIN_SCORE=0.28

# Supabase Auth & Database (Optional - For Student Registration & Profile Addendum)
# If absent: Works in demo simulation mode with local session persistence
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Frontend API URL (Leave blank for same-origin or development proxy)
VITE_API_BASE_URL=
